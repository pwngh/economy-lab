{
  "name": "@pwngh/economy-ui",
  "version": "0.1.0",
  "description": "React hooks for an economy storefront",
  "license": "MIT",
  "author": "Preston Neal",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pwngh/economy-lab.git",
    "directory": "packages/ui"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "pretest": "tsc -p . --noEmit",
    "test": "node ../../scripts/check-package-fresh.ts && node --import tsx --test-timeout=600000 --test test/*.test.tsx",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@pwngh/economy-client": "^0.1.0",
    "@pwngh/economy-core": "^0.1.0",
    "@pwngh/economy-lab": "^0.7.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@pwngh/economy-auth": "^0.1.0",
    "@pwngh/economy-money": "^0.1.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/pwngh/economy-lab/tree/main/packages/ui#readme"
}
