{
  "name": "@pwngh/economy-conformance",
  "version": "0.1.0",
  "description": "Hold a store, cache, rate limiter, dispatcher or processor to its contract",
  "license": "MIT",
  "author": "Preston Neal",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pwngh/economy-lab.git",
    "directory": "packages/conformance"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "pretest": "tsc -p . --noEmit",
    "test": "node ../../scripts/check-package-fresh.ts && node --import tsx --test-timeout=600000 --test test/*.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@pwngh/economy-lab": "^0.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "conformance",
    "contract",
    "store",
    "test-suite",
    "adapter",
    "economy"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/pwngh/economy-lab/tree/main/packages/conformance#readme"
}
