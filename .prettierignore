# Prettier has no SQL parser; the db/ schema files are kept formatted by hand.
*.sql

node_modules
coverage

# Publish artifacts: dist is compiled output, .build-tmp is its throwaway staging copy.
dist
.build-tmp

package-lock.json
Dockerfile
.dockerignore

# Standalone front-end apps own their formatting (apps/docs uses biome), and apps/support holds
# the browser-build shim stubs both apps alias to (never imported by name). Mirrors the eslint ignore.
apps

# notes/ is private planning text, never committed and not format-governed.
notes

# Byte-pinned generated artifacts; reformatting one breaks its snapshot test. Named by extension,
# not by directory: the generator that writes them lives here too, and a whole-directory ignore
# took it out of format:check silently.
test/fixtures/*.json
dist-site

# docs/ is the gitignored generated API reference (wiped and rebuilt by every typedoc run).
docs
