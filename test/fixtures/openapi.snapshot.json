      "Op_adjust": {
        "type": "object",
        "required": [
          "kind",
          "idempotencyKey",
          "account",
          "amount",
          "reason"
        ],
        "properties": {
          "kind": {
            "const": "adjust"
          },
          "idempotencyKey": {
            "type": "string"
          },
          "actor": {
            "$ref": "#/components/schemas/Principal"
          },
          "account": {
