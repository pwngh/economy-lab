{
  "name": "@pwngh/economy-lab",
  "version": "0.7.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "imports": {
    "#src/*": "./src/*",
    "#test/*": "./test/*",
    "#scripts/*": "./scripts/*",
    "#economy/*": "./economy/*"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./ports": {
      "types": "./dist/src/ports.d.ts",
      "default": "./dist/src/ports.js"
    },
    "./adapters": {
      "types": "./dist/src/adapters/index.d.ts",
      "default": "./dist/src/adapters/index.js"
    },
    "./worker": {
      "types": "./dist/src/worker/index.d.ts",
      "default": "./dist/src/worker/index.js"
    },
    "./server": {
      "types": "./dist/src/server.d.ts",
      "default": "./dist/src/server.js"
    },
    "./client": {
      "types": "./dist/src/client.d.ts",
      "default": "./dist/src/client.js"
    },
    "./contract": {
      "types": "./dist/src/wire-contract.d.ts",
      "default": "./dist/src/wire-contract.js"
    },
    "./netting": {
      "types": "./dist/src/netting.d.ts",
      "default": "./dist/src/netting.js"
    },
    "./supervisor": {
      "types": "./dist/src/supervisor/index.d.ts",
      "default": "./dist/src/supervisor/index.js"
    },
    "./store-kit": {
      "types": "./dist/src/store-kit.d.ts",
      "default": "./dist/src/store-kit.js"
    },
    "./sql-kit": {
      "types": "./dist/src/sql-kit.d.ts",
      "default": "./dist/src/sql-kit.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.md"
  ],
  "description": "A provably-solvent credits economy: wallets, payouts, subscriptions, and a marketplace, on one double-entry ledger.",
  "author": "Preston Neal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pwngh/economy-lab.git"
  },
  "bugs": {
    "url": "https://github.com/pwngh/economy-lab/issues"
  },
  "homepage": "https://economy-lab-docs.pages.dev/economy/",
  "scripts": {
    "dev": "economy dev",
    "docs:api": "typedoc",
    "site": "npm run docs:api && npm run build --prefix apps/docs && npm run build --prefix apps/console && node site/src/compose.mjs",
    "site:dev": "node site/src/dev.mjs",
    "site:deploy": "npm run verify --prefix apps/docs && npm run verify --prefix apps/console && npm run check:ref --prefix apps/docs && npm run site && npm run check:csp --prefix apps/docs -- ../../dist-site && npm run check:static --prefix apps/docs && node apps/console/scripts/bundle-budget.mjs && apps/docs/node_modules/.bin/wrangler pages deploy --branch=production --commit-dirty=true",
    "start": "node --env-file-if-exists=.env node_modules/@pwngh/economy/dist/cli-entry.js serve",
    "worker": "node --env-file-if-exists=.env node_modules/@pwngh/economy/dist/cli-entry.js worker",
    "test": "node --env-file-if-exists=.env --test-timeout=600000 --test --test-reporter=./test/support/numbered.reporter.mjs --test-reporter-destination=stdout --test-reporter=./scripts/support/counted.reporter.mjs --test-reporter-destination=stderr \"test/**/*.test.ts\"",
    "test:packages": "node --env-file-if-exists=.env scripts/test-packages.mjs",
    "coverage": "node --env-file-if-exists=.env --test-timeout=600000 --test --experimental-test-coverage \"test/**/*.test.ts\"",
    "build": "node scripts/build-dist.mjs",
    "prepublishOnly": "npm run build && npm run build:packages && npm run check",
    "check": "node scripts/check.ts",
    "build:packages": "node scripts/build-packages.mjs",
    "publish:preflight": "node scripts/publish-packages.mjs --preflight-only",
    "publish:packages": "node scripts/publish-packages.mjs",
    "check:samples": "node scripts/check-samples.mjs",
    "check:browser": "node scripts/check-browser.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier -c .",
    "format:write": "prettier -w .",
    "docker": "sh rigs/docker.sh",
    "db:migrate": "sh scripts/migrate.sh",
    "db:clean": "node --env-file-if-exists=.env rigs/db-clean.ts",
    "prove": "node scripts/check.ts prove",
    "fuzz": "node scripts/check.ts fuzz",
    "prop": "node scripts/check.ts property",
    "smoke": "node scripts/check.ts smoke",
    "bench": "node --env-file-if-exists=.env scripts/bench.ts",
    "bench:queue": "node --env-file-if-exists=.env scripts/bench-queue.ts",
    "bench:scale": "node --env-file-if-exists=.env scripts/bench-scale.ts",
    "bench:multinode": "node --env-file-if-exists=.env scripts/bench-multinode.ts",
    "bench:wire": "node --env-file-if-exists=.env scripts/bench-wire.ts",
    "bench:profile": "node --env-file-if-exists=.env scripts/profile-statements.ts",
    "scale": "node --env-file-if-exists=.env scripts/scale.ts",
    "trace": "node scripts/trace.ts",
    "trace:check": "node scripts/trace.ts --check",
    "demo": "economy dev --demo",
    "demo:balances": "node scripts/demo-balances.mjs",
    "test:balances": "node --test-timeout=600000 --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./scripts/support/counted.reporter.mjs --test-reporter-destination=stderr test/conformance/balance-holds.test.ts",
    "demo:ops": "node --env-file-if-exists=.env scripts/demo-ops.ts",
    "backup": "node --env-file-if-exists=.env scripts/backup.ts",
    "restore:drill": "node --env-file-if-exists=.env scripts/restore-drill.ts",
    "audit:verify": "node scripts/audit-verify.ts",
    "ledger:verify": "node scripts/ledger-verify.ts",
    "suite": "node scripts/suite.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@pwngh/economy-edge": "^0.1.0",
    "@pwngh/economy-lab": "file:.",
    "@pwngh/taskq": "0.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "axe-core": "^4.12.1",
    "esbuild": "^0.27.7",
    "eslint": "^9.13.0",
    "eslint-plugin-n": "^17.0.0",
    "jiti": "^2.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.3.3",
    "typedoc": "0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0"
  },
  "peerDependencies": {
    "@pwngh/economy-edge": "^0.1.0",
    "@pwngh/taskq": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@pwngh/economy-edge": {
      "optional": true
    },
    "@pwngh/taskq": {
      "optional": true
    }
  },
  "keywords": [
    "ledger",
    "double-entry",
    "idempotency",
    "exactly-once",
    "outbox",
    "saga",
    "payouts",
    "marketplace",
    "postgres",
    "mysql",
    "virtual-currency",
    "economy"
  ],
  "engines": {
    "node": ">=22.18.0"
  }
}
